{$CADDY_SITE_ADDRESS::80} {
    root * /srv/replays
    encode zstd gzip

    # Redirect /watch/filename.mp4 to /watch/filename
    @watchmp4 path_regexp watchmp4 ^(/watch/.+)\.mp4$
    redir @watchmp4 {re.watchmp4.1} 301

    # Discord video embed watch page
    @watchpage path_regexp watchpage ^/watch/(.+)$
    handle @watchpage {
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "no-store"
        respond `<!DOCTYPE html>
<html>
<head>
    <meta property="og:title" content="osu! Replay" />
    <meta property="og:description" content="Rendered osu! replay video" />
    <meta property="og:site_name" content="Replay Server" />
    <meta property="og:type" content="video.other" />
    <meta property="og:image" content="/{re.watchpage.1}.jpg" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:video" content="/{re.watchpage.1}.mp4" />
    <meta property="og:video:url" content="/{re.watchpage.1}.mp4" />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1280" />
    <meta property="og:video:height" content="720" />
    <meta name="twitter:card" content="player" />
    <meta name="twitter:player" content="/{re.watchpage.1}.mp4" />
    <meta name="theme-color" content="#96DFE3" />
</head>
<body style="margin:0; background:#1f1f1f; color:#f5f5f5; text-align:center;">
    <video controls autoplay style="width:100%; max-height:80vh; margin:auto;">
        <source src="/{re.watchpage.1}.mp4" type="video/mp4">
    </video>
    <div style="margin-top:20px;">
        <a href="/{re.watchpage.1}.mp4" download style="display:inline-flex; align-items:center; justify-content:center; padding:12px 20px; border-radius:10px; background:#2d2d2d; color:#f5f5f5; text-decoration:none; font-weight:bold; border:1px solid rgba(255,255,255,0.12);">
            Download Replay
        </a>
    </div>
</body>
</html>` 200
    }

    # Proxy uploads to fileserver service
    handle /upload* {
        reverse_proxy fileserver:{$UPLOAD_PORT:5555}
    }

    # Serve static replay files
    file_server
}
