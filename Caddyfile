{$CADDY_SITE_ADDRESS::80} {
	root * /srv/replays

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	# 1. Block dotfiles and atomic staging files (.{uuid}_{stem}.tmp*, /.stubs, /.sprites)
	@hidden path /.*
	handle @hidden {
		header Cache-Control "no-store"
		respond "Not Found" 404
	}

	# 2. Favicon (/favicon.ico, /favicon.svg)
	@favicon {
		path /favicon.ico /favicon.svg
		method GET HEAD
	}
	handle @favicon {
		header Content-Type "image/svg+xml; charset=utf-8"
		header Cache-Control "public, max-age=604800"
		rewrite * /favicon.svg
		file_server {
			root /etc/caddy/replays
		}
	}

	# 3. Canonicalize /watch/<slug>.mp4 -> /watch/<slug>
	@watchmp4 path_regexp watchmp4 ^(/watch/[A-Za-z0-9._-]+)\.mp4$
	handle @watchmp4 {
		redir * {re.watchmp4.1} 301
	}

	# 4. Block public access to internal fileserver endpoints
	@internal_only path /upload* /health*
	handle @internal_only {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		respond "Not Found" 404
	}

	# 5. Live stats dashboard (/stats)
	@stats {
		path /stats /stats/
		method GET HEAD
	}
	handle @stats {
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://a.ppy.sh https://osu.ppy.sh; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		encode zstd gzip
		rewrite * /stats.html
		templates {
			root /srv/replays
		}
		file_server {
			root /etc/caddy/replays
		}
	}

	# 5b. Web replay render uploader & live queue (/render)
	@render_page {
		path /render /render/
		method GET HEAD
	}
	handle @render_page {
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://a.ppy.sh https://osu.ppy.sh; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		encode zstd gzip
		rewrite * /render.html
		file_server {
			root /etc/caddy/replays
		}
	}

	# 5c. Web replay render config (/config)
	@config_page {
		path /config /config/
		method GET HEAD
	}
	handle @config_page {
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://a.ppy.sh https://osu.ppy.sh; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		encode zstd gzip
		rewrite * /config.html
		file_server {
			root /etc/caddy/replays
		}
	}

	# 5d. Shared drag-and-drop & browser config script (/render-shared.js)
	@render_shared_js {
		path /render-shared.js
		method GET HEAD
	}
	handle @render_shared_js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "public, max-age=0, must-revalidate"
		header CDN-Cache-Control "no-store"
		header Cloudflare-CDN-Cache-Control "no-store"
		encode zstd gzip
		file_server {
			root /etc/caddy/replays
		}
	}

	# 5d2. Shared theme stylesheet (/themes.css)
	@themes_css {
		path /themes.css
		method GET HEAD
	}
	handle @themes_css {
		header Content-Type "text/css; charset=utf-8"
		header Cache-Control "public, max-age=0, must-revalidate"
		header CDN-Cache-Control "no-store"
		header Cloudflare-CDN-Cache-Control "no-store"
		encode zstd gzip
		file_server {
			root /etc/caddy/replays
		}
	}

	# 5e. Web render & osu! OAuth backend API (proxied to palentirbot)
	@web_render_api path /api/web-render/* /api/auth/*
	handle @web_render_api {
		header Cache-Control "private, no-store, no-cache, must-revalidate"
		header CDN-Cache-Control "no-store"
		header Cloudflare-CDN-Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		reverse_proxy {$WEB_RENDER_UPSTREAM:bot:5556} {
			header_up X-Real-IP {client_ip}
		}
	}

	# 6. Watch page (/watch/<short_id> or legacy /watch/<slug>)
	@watchpage path_regexp watchpage ^/watch/([A-Za-z0-9._-]+)$
	handle @watchpage {
		@mp4_exists file /{re.watchpage.1}.mp4
		handle @mp4_exists {
			header Cache-Control "public, max-age=300, s-maxage=3600"
			header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://a.ppy.sh https://osu.ppy.sh; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
			encode zstd gzip
			rewrite * /watch.html
			templates {
				root /srv/replays
			}
			file_server {
				root /etc/caddy/replays
			}
		}

		@short_mp4 file /.links/{re.watchpage.1}.mp4
		handle @short_mp4 {
			@short_txt file /.links/{re.watchpage.1}.txt
			handle @short_txt {
				header Cache-Control "public, max-age=300, s-maxage=3600"
				header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://a.ppy.sh https://osu.ppy.sh; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
				encode zstd gzip
				rewrite * /watch.html
				templates {
					root /srv/replays
				}
				file_server {
					root /etc/caddy/replays
				}
			}
		}

		handle {
			header Cache-Control "no-store"
			header X-Robots-Tag "noindex"
			header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://a.ppy.sh https://osu.ppy.sh; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
			encode zstd gzip
			rewrite * /404.html
			templates
			file_server {
				root /etc/caddy/replays
				status 404
			}
		}
	}

	@watch_bad path /watch*
	handle @watch_bad {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://a.ppy.sh https://osu.ppy.sh; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		encode zstd gzip
		rewrite * /404.html
		templates
		file_server {
			root /etc/caddy/replays
			status 404
		}
	}

	# 7. Replay gallery at root (GET/HEAD /)
	@gallery {
		path /
		method GET HEAD
	}
	handle @gallery {
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://a.ppy.sh https://osu.ppy.sh; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		encode zstd gzip
		templates {
			between [[ ]]
			root /srv/replays
		}
		file_server {
			browse /etc/caddy/replays/gallery.html
			hide .*
		}
	}

	# 8. Fallback thumbnail
	@fallback_thumb {
		path /fallback-thumb.jpg
		method GET HEAD
	}
	handle @fallback_thumb {
		header Cache-Control "public, max-age=604800, immutable"
		rewrite * /fallback_thumb.jpg
		file_server {
			root /etc/caddy/replays
		}
	}

	# 9. Hover storyboard sprites (/sprites/<slug>.webp -> /.sprites/<slug>.webp)
	@sprites {
		path_regexp sprites ^/sprites/([A-Za-z0-9._-]+)\.webp$
		method GET HEAD
	}
	handle @sprites {
		@sprite_exists file /.sprites/{re.sprites.1}.webp
		handle @sprite_exists {
			header Cache-Control "public, max-age=604800, immutable"
			rewrite * /.sprites/{re.sprites.1}.webp
			file_server
		}
		handle {
			header Cache-Control "no-store"
			respond "Not Found" 404
		}
	}

	# 10. Instant Discordbot MP4 validator stub
	@discord_mp4_probe {
		path_regexp discord_mp4 ^/([A-Za-z0-9._-]+)\.mp4$
		method GET HEAD
		header User-Agent *Discordbot*
		file {path}
	}
	handle @discord_mp4_probe {
		header Cache-Control "private, no-store, no-cache, must-revalidate"
		header CDN-Cache-Control "no-store"
		header Cloudflare-CDN-Cache-Control "no-store"
		@custom_stub file /.stubs/{re.discord_mp4.1}.stub.mp4
		handle @custom_stub {
			rewrite * /.stubs/{re.discord_mp4.1}.stub.mp4
			file_server
		}
		handle {
			rewrite * /discord_stub.mp4
			file_server {
				root /etc/caddy/replays
			}
		}
	}

	# 11. Mutable archive index (/index.json)
	@index_json {
		path /index.json
		method GET HEAD
		file /index.json
	}
	handle @index_json {
		header Cache-Control "no-cache"
		encode zstd gzip
		file_server
	}

	# 12. Static replay media assets (*.mp4, *.jpg, *.webp)
	@media_assets {
		path /*.mp4 /*.jpg /*.webp
		method GET HEAD
		file {path}
	}
	handle @media_assets {
		header Cache-Control "public, max-age=604800, immutable"
		file_server {
			hide .*
		}
	}

	# 13. Static metadata sidecars (*.json)
	@json_assets {
		path /*.json
		method GET HEAD
		file {path}
	}
	handle @json_assets {
		header Cache-Control "public, max-age=604800, immutable"
		encode zstd gzip
		file_server {
			hide .*
		}
	}

	# 14. Fallback 404
	handle {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://a.ppy.sh https://osu.ppy.sh; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		encode zstd gzip
		rewrite * /404.html
		templates
		file_server {
			root /etc/caddy/replays
			status 404
		}
	}
}
