# =============================================================================
# 1. REQUIRED: Discord & osu! API Credentials
# =============================================================================
DISCORD_TOKEN = ""       # Discord Bot Token (Discord Developer Portal -> Bot -> Token)
OSU_CLIENT_ID =          # osu! OAuth Client ID (osu! Profile Settings -> OAuth)
OSU_CLIENT_SECRET = ""   # osu! OAuth Client Secret
OSU_API_KEY = ""         # osu! legacy v1 API Key

OWNERS_USER_ID =         # Your Discord User ID (Bot owner)
DEV_GUILD_ID =           # Your Discord Server/Guild ID (For command testing)

# =============================================================================
# 2. Hosting & Replay Server Configuration
# =============================================================================
# Public URL used in Discord embeds (points to your Caddy reverse proxy or domain)
PUBLIC_REPLAY_BASE_URL = "http://localhost:8085"

# Host port for Caddy web server (default 8085 prevents conflict with local services)
CADDY_HTTP_PORT = 8085

# Optional: Domain for Caddy automatic HTTPS (e.g. "replays.yourdomain.com")
# CADDY_SITE_ADDRESS = "replays.yourdomain.com"

# Upload speed in Mbps used to compute Discord cache warmup delay.
# Set to "auto" (default) to benchmark host speed dynamically, or set a fixed number (e.g. 25.0)
UPLOAD_MBPS = "auto"

# =============================================================================
# 3. AUTOMATIC DEFAULTS (Pre-configured for Docker/Podman - No manual editing needed)
# =============================================================================
# PostgreSQL database URL (In Docker/Podman compose, this is handled automatically)
DATABASE_URL = "postgres://palentirbot:palentirbot_pass@localhost:5432/palentirbot"

# Internal replay upload receiver settings
UPLOAD_SECRET = "palentir_replay_secret_key"
UPLOAD_PORT = 5555
UPLOAD_URL = "http://127.0.0.1:5555/upload"

# Danser paths (Default is ./data/ which contains binaries, songs, skins, replays)
DANSER_PATH = "./data/"
FOLDERS_PATH = "./data/"

# Logging
RUST_LOG = "palentirbot=debug,info"

# =============================================================================
# 4. Discord Custom Emojis (Optional overrides)
# =============================================================================
MAN_RUNNING = "<:man_running_escaped:1018147731677663294>"
WHITE_CHECK_MARK = "<:white_check_mark_escaped:1018154362364776478>"
HOURGLASS = "<:hourglass_escaped:1018154809515323412>"
EMOJI_HIT_300 = "<:hit300:1501970711345102898>"
EMOJI_HIT_100 = "<:hit100:1501970701895204864>"
EMOJI_HIT_50 = "<:hit50:1501970692248305796>"
EMOJI_HIT_MISS = "<:hitmiss:1501970676968325252>"
GRADE_XH = "<:grade_xh:1502280099653877850>"
GRADE_X = "<:grade_x:1502280098059911178>"
GRADE_SH = "<:grade_sh:1502280096772526190>"
GRADE_S = "<:grade_s:1502280086840279071>"
GRADE_A = "<:grade_a:1502280077495505028>"
GRADE_B = "<:grade_b:1502280078762053763>"
GRADE_C = "<:grade_c:1502280080431251556>"
GRADE_D = "<:grade_d:1502280081551265943>"
GRADE_FAIL = "<:grade_fail:1502280083031982201>"

# =============================================================================
# 5. AI Settings (Ollama + SearXNG)
# =============================================================================
# Global toggle for AI module (default: false in bot, true here for opt-in deployments)
AI_ENABLED = true

AI_PROVIDER = "ollama"
OLLAMA_URL = "http://127.0.0.1:11434"

# Default model: tuned for 8GB GPU VRAM (Quadro RTX 4000) + System RAM overflow for 40k context
# Alternatives:
#   - "huihui_ai/deepseek-r1-abliterated:8b-0528-qwen3"
#   - "goekdenizguelmez/JOSIEFIED-Qwen3:8b-deepseek-r1-0528"
#   - "huihui_ai/qwen3-abliterated:8b-v2"
OLLAMA_MODEL = "hf.co/Abiray/Qwen3.5-9B-abliterated-GGUF:Q4_K_M"

# 40,960 token KV cache for long Discord chat history and reasoning chains
OLLAMA_NUM_CTX = 40960
# 8,192 token prediction limit prevents deep thoughts from being cut off mid-reasoning
OLLAMA_NUM_PREDICT = 8192
OLLAMA_THINK_ENABLED = true

OLLAMA_REPEAT_PENALTY = 1.15
OLLAMA_REPEAT_LAST_N = 256
OLLAMA_PRESENCE_PENALTY = 0.0
OLLAMA_FREQUENCY_PENALTY = 0.0
# DeepSeek-R1-0528 / Qwen3 recommended sampling parameters
OLLAMA_TEMPERATURE = 0.6
OLLAMA_TOP_P = 0.95
OLLAMA_TIMEOUT_SECS = 180
AI_HISTORY_MESSAGES = 100
AI_MAX_QUEUE_SIZE = 15
AI_SYSTEM_PROMPT = "prompt.txt"

# SearXNG Web & Media Search Integration
# Leave empty to gracefully disable web & media search
SEARXNG_URL = "http://127.0.0.1:8080"
# SafeSearch level: 0 = Off (default), 1 = Moderate, 2 = Strict
AI_SAFESEARCH = 0
